{
    "name": "smart-on-fhir-validator",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "e2e"
    ],
    "type": "module",
    "scripts": {
        "dev": "next dev -p 3001",
        "build": "next build",
        "start": "next start",
        "generate-key": "node --experimental-strip-types scripts/generate-key.ts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "tsc": "next typegen && tsc --noEmit",
        "test": "vitest --project unit --run",
        "test:watch": "vitest --project unit",
        "test:integration": "vitest --project integration --run",
        "test:coverage": "vitest run --coverage",
        "e2e": "yarn workspace e2e run e2e",
        "e2e:install": "yarn workspace e2e run e2e:install"
    },
    "dependencies": {
        "@navikt/ds-css": "^8.16.2",
        "@navikt/ds-tailwind": "^8.16.1",
        "clsx": "^2.1.1",
        "hono": "^4.13.7",
        "jose": "^6.2.12",
        "next": "16.3.4",
        "next-logger": "^5.0.2",
        "pino": "^10.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zod": "^4.6.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/fhir": "^0.0.44",
        "@types/node": "^24.13.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "5.0.0",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.0",
        "vitest": "5.0.0",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
