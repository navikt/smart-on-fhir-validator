{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["node", "@playwright/test"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "playwright-report", "test-results"]
}
